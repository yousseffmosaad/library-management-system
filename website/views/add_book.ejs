<!DOCTYPE html>
<html>
<head><title>Add Book</title></head>
<body style="font-family: Arial; margin: 30px;">
    <h2>Add New Book</h2>
    <% if (typeof error !== 'undefined') { %><p role="alert" style="color: #b00020;"><%= error %></p><% } %>
    <form action="/book/add" method="POST" enctype="multipart/form-data">
        <label>Book ID:</label><br><input type="number" name="book_id" min="1" step="1" required><br><br>
        <label>Title:</label><br><input type="text" name="title" required><br><br>
        <label>Price:</label><br><input type="number" step="0.01" min="0" name="price" required><br><br>
        <label>Author:</label><br>
        <select name="author_id" required>
            <% authors.forEach(author => { %><option value="<%= author.author_id %>"><%= author.name %> (ID: <%= author.author_id %>)</option><% }) %>
        </select><br><br>
        <label>Book cover (JPEG, PNG, WebP, or GIF; max 5 MB):</label><br><input type="file" name="image" accept="image/jpeg,image/png,image/webp,image/gif"><br><br>
        <button type="submit">Save Book</button>
    </form>
    <br><a href="/dashboard">Back to Dashboard</a>
</body>
</html>