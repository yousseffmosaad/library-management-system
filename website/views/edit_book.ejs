<!DOCTYPE html>
<html>
<head><title>Edit Book</title></head>
<body style="font-family: Arial; margin: 30px;">
    <h2>Edit Book</h2>
    <% if (book.cover_image) { %><p>Current cover:</p><img src="<%= book.cover_image %>" alt="Cover of <%= book.title %>" style="max-width: 180px; max-height: 240px; object-fit: cover;"><br><br><% } %>
    <form action="/book/edit/<%= book.book_id %>" method="POST" enctype="multipart/form-data">
        <label>Title:</label><br><input type="text" name="title" value="<%= book.title %>" required><br><br>
        <label>Price:</label><br><input type="number" step="0.01" min="0" name="price" value="<%= book.price %>" required><br><br>
        <label>Author:</label><br>
        <select name="author_id" required>
            <% authors.forEach(author => { %><option value="<%= author.author_id %>" <%= String(author.author_id) === String(book.author_id) ? 'selected' : '' %>><%= author.name %></option><% }) %>
        </select><br><br>
        <label>Replace cover (JPEG, PNG, WebP, or GIF; max 5 MB):</label><br><input type="file" name="image" accept="image/jpeg,image/png,image/webp,image/gif"><br><br>
        <button type="submit">Update Book</button>
    </form>
    <br><a href="/dashboard">Back to Dashboard</a>
</body>
</html>